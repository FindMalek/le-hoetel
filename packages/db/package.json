{
  "name": "@ritorno/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ../../scripts/with-env.mjs bun src/migrate-cli.ts",
    "db:seed": "node ../../scripts/with-env.mjs bun src/seed-cli.ts",
    "db:studio": "node ../../scripts/with-env.mjs bun x drizzle-kit studio"
  },
  "dependencies": {
    "@ritorno/common": "workspace:*",
    "@ritorno/notification": "workspace:*",
    "@ritorno/storage": "workspace:*",
    "drizzle-orm": "catalog:",
    "better-auth": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@ritorno/config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
