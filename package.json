{
  "name": "ritorno",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-env.mjs turbo dev",
    "dev:web": "node scripts/with-env.mjs turbo dev -F web -F api",
    "dev:dashboard": "node scripts/with-env.mjs turbo dev -F dashboard -F api",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "lint": "biome ci . && oxlint",
    "check": "biome check --write .",
    "agents": "npx --yes @intellectronica/ruler@0.3.46 apply",
    "db:up": "node scripts/with-env.mjs docker compose -f docker/docker-compose.yml up -d",
    "db:down": "node scripts/with-env.mjs docker compose -f docker/docker-compose.yml down",
    "db:generate": "turbo db:generate -F @ritorno/db",
    "db:migrate": "turbo db:migrate -F @ritorno/db",
    "db:seed": "turbo db:seed -F @ritorno/db",
    "db:studio": "turbo db:studio -F @ritorno/db",
    "bump-deps": "pnpm update --recursive --latest",
    "ui:add": "pnpm --filter @ritorno/ui exec shadcn add",
    "logo:build": "pnpm --filter @ritorno/ui logo:build",
    "dev:email": "turbo dev -F email",
    "email:export": "turbo export -F email",
    "dev:worker": "node scripts/with-env.mjs bun --watch apps/api/src/worker.ts",
    "test:e2e": "pnpm --filter e2e run e2e",
    "dev:secrets": "infisical run --env=dev -- pnpm dev",
    "env:check": "node scripts/env-check.mjs",
    "secrets:pull": "node .github/scripts/secrets-pull.mjs",
    "preview:creds": "node .github/scripts/preview-creds.mjs",
    "i18n:check": "bun packages/i18n/src/check-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@shadcn/lint": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}
