{
  "ci": {
    "collect": {
      "url": ["http://localhost:4100/h/dar-zitouna?lang=en", "http://localhost:4100/h/dar-zitouna?lang=ar"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new", "onlyCategories": ["performance", "accessibility"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 300000, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
