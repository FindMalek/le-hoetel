{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "shadcn": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "vercel": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.vercel.com"
    }
  }
}
