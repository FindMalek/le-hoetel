# Every key the apps read. Locally the values come from the Infisical `dev` environment (docs: Secrets);
# a root .env is optional and only fills what Infisical does not hold, or stands in when it is unreachable.

# --- urls -------------------------------------------------------------------
# Where the Next servers reach the api (inside docker/dokploy: the api service url).
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002
DOCS_URL=http://localhost:3003

# --- database ---------------------------------------------------------------
# Host port for the local docker postgres (pnpm db:up)
POSTGRES_PORT=5432
POSTGRES_USER=ritorno
POSTGRES_DB=ritorno
DATABASE_URL=postgres://ritorno:ritorno@localhost:5432/ritorno
# demo = seed an empty database with realistic data; none = never
SEED=demo
# password of the seeded demo accounts (admin@ and owner.<hotel>@demo.ritorno.test); empty = the documented default
DEMO_PASSWORD=

# --- auth (better-auth) -----------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# First admin, created or reset on every api start
ADMIN_EMAIL=admin@ritorno.local
ADMIN_PASSWORD=
# Who is emailed when a hotel requests a demo (defaults to ADMIN_EMAIL)
LEADS_NOTIFY_EMAIL=
# Optional: GitHub sign-in (callback: <DASHBOARD_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- landing page -----------------------------------------------------------
# WhatsApp button of the landing page: country code and number, digits only (21612345678). Empty hides the button.
WHATSAPP_CONTACT_NUMBER=
# owner/name, shows stars in the footer
GITHUB_REPO=
GITHUB_TOKEN=

# --- logging ----------------------------------------------------------------
# debug | info | warn | error. Json lines in production, readable lines in dev.
LOG_LEVEL=info

# --- cache and rate limiting ------------------------------------------------
# Cached values and counters live in memory per api process. For several replicas share them through Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- background jobs (pg-boss, in the same postgres) ------------------------
# true = the api also runs the worker and cron. false = it only enqueues; run the worker apart (docs: Jobs).
JOBS_WORKER=true

# --- storage (any S3 API: Garage, R2, AWS, MinIO) ---------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- notification (email, whatsapp) -------------------------------------------
# Real messages only go out with NODE_ENV=production and MESSAGING_LIVE=true, in production only.
# Everywhere else (local, tests, previews, staging) every channel only logs, without recipient or text.
# Inside a live setup a channel turns on when its keys are set; leave a block empty to keep it off.
MESSAGING_LIVE=false
# Email (Resend). Add your domain: pnpm --filter @ritorno/notification domain example.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Ritorno <onboarding@resend.dev>
# WhatsApp (Kapso). Connect a number in https://app.kapso.ai, then: pnpm --filter @ritorno/notification whatsapp:setup
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Who notifications go to by default, e.g. +15551234567
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=app_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- ai (Vercel AI SDK) -----------------------------------------------------
# provider:model, provider = groq | openai | anthropic
AI_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- analytics (Umami, self-hosted) -----------------------------------------
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- traces (OpenObserve, self-hosted) --------------------------------------
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=

# --- errors (GlitchTip, sentry dsn from your project) -----------------------
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=

# --- turbo remote cache (optional) ------------------------------------------
TURBO_API=
TURBO_TEAM=
TURBO_TOKEN=

# Staging only: also trust browser origins of PR previews and *.findmalek.engineer
ALLOW_PREVIEW_ORIGINS=false
