{
  "context_servers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "source": "custom"
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "source": "custom"
    },
    "vercel": {
      "url": "https://mcp.vercel.com",
      "source": "custom"
    }
  }
}